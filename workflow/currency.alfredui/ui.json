{
 "bundleid": "com.aliafshany.currency-toman.ui",
 "log": {
  "level": "info",
  "internal": true
 },
 "variablesconfig": {
  "input_query": {
   "src": "args[0]"
  }
 },
 "colours": {
  "card": "#8080801A",
  "field": "#8080802E"
 },
 "window": {
  "title": "Currency",
  "movablebybackground": true,
  "size": {
   "width": 640,
   "height": 460
  },
  "padding": 0,
  "root": {
   "id": "root",
   "type": "view",
   "layout": "flex",
   "padding": 14,
   "background": "windowBackgroundColor",
   "rows": 3,
   "cols": 1,
   "spacing": 10,
   "events": [
    {
     "triggers": "launched",
     "action": {
      "type": "script",
      "src": "cards",
      "args": [
       "launch",
       "{var:input_query}"
      ],
      "async": true
     }
    }
   ],
   "shortcuts": [
    {
     "shortcut": "↓",
     "action": {
      "type": "function",
      "src": "list",
      "args": "selectnext"
     }
    },
    {
     "shortcut": "↑",
     "action": {
      "type": "function",
      "src": "list",
      "args": "selectprevious"
     }
    },
    {
     "shortcut": "⌘↩",
     "action": {
      "type": "script",
      "src": "cards",
      "args": [
       "paste",
       "{value:in.text}",
       "{value:list.selected.arg}",
       "{value:list.selected.paste}",
       "{value:list.selected.ac}",
       "{value:list.selected.valid}"
      ],
      "async": true
     }
    }
   ],
   "components": [
    {
     "constraints": {
      "grid": {
       "row": 0,
       "col": 0
      }
     },
     "id": "in",
     "type": "textfield",
     "text": "",
     "placeholder": "100 try  ·  5m irt  ·  1200+350 try  ·  2 emami  ·  100 try eur",
     "focus": true,
     "font": {
      "size": 20
     },
     "background": "field",
     "bordered": false,
     "focusring": false,
     "textinsets": {
      "horizontal": 10,
      "vertical": 8
     },
     "events": [
      {
       "triggers": "changed",
       "action": {
        "type": "script",
        "src": "cards",
        "args": [
         "list",
         "{value:self.text}"
        ],
        "async": true
       }
      },
      {
       "triggers": "actioned",
       "action": {
        "type": "script",
        "src": "cards",
        "args": [
         "act",
         "{value:in.text}",
         "{value:list.selected.arg}",
         "{value:list.selected.paste}",
         "{value:list.selected.ac}",
         "{value:list.selected.valid}"
        ],
        "async": true
       }
      }
     ]
    },
    {
     "constraints": {
      "grid": {
       "row": 1,
       "col": 0,
       "rowweight": 1.0
      }
     },
     "type": "view",
     "layout": "border",
     "padding": 6,
     "background": "card",
     "cornerradius": 10,
     "components": [
      "{file:components/list.json}"
     ]
    },
    {
     "constraints": {
      "grid": {
       "row": 2,
       "col": 0
      }
     },
     "type": "label",
     "text": "↑↓ select  ·  ↩ copy number  ·  ⌘↩ paste with currency  ·  ↩ on a suggestion completes it  ·  ⎋ close",
     "colour": "secondaryLabelColor",
     "font": {
      "size": 11
     },
     "textalign": "right"
    }
   ]
  }
 }
}